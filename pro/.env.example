# نسخ هذا الملف إلى .env (أو تصدير المتغيرات يدوياً في PowerShell) قبل التشغيل.
# لا تضع أي بيانات حقيقية/حساسة هنا - هذا ملف مثال فقط.

# -------- MongoDB --------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=bigdata_midterm

# -------- ملفات البيانات --------
# المسار للملف الصغير (Python Batch) والملف الضخم (PySpark)
SAMPLE_FILE=data/orders_sample_100000.csv
ORIGINAL_FILE=data/orders_huge_mixed_quality.csv

# -------- التوجيه بين المحركين --------
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=10000

# -------- PySpark (Windows) --------
# عدّل هذين المسارين حسب بيئتك إذا كان اسم المستخدم في مسار Windows
# يحتوي أحرفاً غير لاتينية (انظر القسم 10 في README لتفاصيل المشكلة والحل)
SPARK_JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot
SPARK_HOME_OVERRIDE=D:\spark_home

# -------- FastAPI --------
API_HOST=0.0.0.0
API_PORT=8000
